(async function testFillCreateUserFormV5() {
    console.log("=== BẮT ĐẦU TEST FORM TẠO USER (V5 - FIX MATCHING) ===");

    // ==========================================
    // 0. DỮ LIỆU CẦN ĐIỀN
    // ==========================================
    const testData = {
        maKH: "03398389",             // Mã khách hàng cần tìm
        maNV: "10399",                // Mã nhân viên
        ngayHieuLuc: "10/11/2026",    // Ngày hiệu lực dd/MM/yyyy
        donVi: "TTKD"                 // Đơn vị
    };

    // ==========================================
    // 1. TRUY CẬP VÀO IFRAME FORM
    // ==========================================
    let doc = document;
    let win = window;
    const iframe = document.querySelector('iframe[src*="tao-moi-nguoi-dung"]') ||
                   document.querySelector('iframe[src*="nguoi-dung"]') || 
                   document.querySelector('iframe[src*="user"]') ||
                   document.querySelector('div.window.active iframe');

    if (iframe) {
        doc = iframe.contentDocument || iframe.contentWindow.document;
        win = iframe.contentWindow;
        console.log("-> Đã truy cập vào IFrame:", iframe.src || iframe.id);
    }

    const sleep = (ms) => new Promise(resolve => setTimeout(resolve, ms));

    // ==========================================
    // 2. HÀM CHỌN SELECT2 CÓ SO KHỚP CHÍNH XÁC NỘI DUNG
    // ==========================================
    async function selectLOVById(selectId, searchValue) {
        console.log(`\n[LOV] Đang xử lý: ${selectId} -> Tìm chính xác mã: "${searchValue}"...`);

        const selectElem = doc.querySelector(selectId);
        if (!selectElem) {
            console.error(`❌ Không tìm thấy phần tử: ${selectId}`);
            return false;
        }

        // 1. Tìm container Select2 tương ứng
        const nextSpan = selectElem.nextElementSibling;
        const select2Btn = (nextSpan && nextSpan.classList.contains('select2-container')) ? 
                           nextSpan.querySelector('.select2-selection') : 
                           doc.querySelector(`span[aria-labelledby*="${selectElem.id}"]`);

        if (!select2Btn) {
            console.error(`❌ Không tìm thấy nút container Select2 của ${selectId}`);
            return false;
        }

        // 2. Mở dropdown Select2
        select2Btn.dispatchEvent(new MouseEvent('mousedown', { bubbles: true }));
        select2Btn.click();
        await sleep(300);

        // 3. Tìm ô input search
        let searchInput = doc.querySelector('.select2-container--open input.select2-search__field') || 
                          doc.querySelector('input.select2-search__field') ||
                          document.querySelector('input.select2-search__field');

        if (!searchInput) {
            console.error(`❌ Không tìm thấy ô search của Select2 khi mở ${selectId}`);
            return false;
        }

        // 4. Xóa trắng ô tìm kiếm và gõ mã mới
        searchInput.focus();
        searchInput.value = "";
        searchInput.dispatchEvent(new Event('input', { bubbles: true }));
        await sleep(100);

        searchInput.value = searchValue;
        searchInput.dispatchEvent(new Event('input', { bubbles: true }));
        
        if (win.jQuery) {
            win.jQuery(searchInput).val(searchValue).trigger('input').trigger('keyup');
        } else {
            searchInput.dispatchEvent(new KeyboardEvent('keyup', { bubbles: true, key: 'a' }));
        }

        console.log(`-> Đã gõ mã "${searchValue}", đang chờ kết quả khớp...`);

        // Đợi tối thiểu 400ms để AJAX bắt đầu gửi request, tránh đọc nhầm kết quả cũ còn lưu
        await sleep(400);

        // 5. Đợi kết quả AJAX render và PHẢI CHỨA searchValue
        const startTime = Date.now();
        let targetItem = null;
        const cleanSearchVal = searchValue.trim().toUpperCase();

        while (Date.now() - startTime < 8000) {
            const results = doc.querySelectorAll('.select2-container--open ul.select2-results__options li.select2-results__option') ||
                            doc.querySelectorAll('ul.select2-results__options li.select2-results__option');

            if (results && results.length > 0) {
                for (let item of results) {
                    // Bỏ qua item đang tải hoặc thông báo
                    if (item.classList.contains('loading-results') || 
                        item.classList.contains('select2-results__message')) {
                        continue;
                    }

                    const itemText = (item.textContent || "").trim().toUpperCase();
                    
                    // ĐIỀU KIỆN QUAN TRỌNG: Item hiển thị PHẢI CHỨA mã đang tìm
                    if (itemText.includes(cleanSearchVal)) {
                        targetItem = item;
                        break;
                    }
                }
            }

            if (targetItem) break;
            await sleep(200);
        }

        // 6. Click chọn kết quả đã khớp
        if (targetItem) {
            console.log(`✔ Đã tìm thấy dòng KHỚP CHÍNH XÁC: "${targetItem.textContent.trim()}". Bắt đầu click...`);
            targetItem.dispatchEvent(new MouseEvent('mouseup', { bubbles: true }));
            targetItem.click();
            await sleep(600); // Đợi hệ thống tự fill các trường liên quan
            console.log(`✔ Đã chọn thành công ${selectId}`);
            return true;
        } else {
            console.error(`❌ Không tìm thấy kết quả nào chứa mã: "${searchValue}" sau 8 giây!`);
            // Click đóng dropdown để tránh che màn hình
            if (doc.body) doc.body.click();
            return false;
        }
    }

    // ==========================================
    // 3. THỰC THI LẦN LƯỢT 4 TRƯỜNG
    // ==========================================

    // --- 1. Mã khách hàng ---
    await selectLOVById('select#customerCode', testData.maKH);

    // --- 2. Mã nhân viên ---
    let nvId = 'select#employeeCode';
    if (!doc.querySelector(nvId)) {
        const nvSelect = doc.querySelector('section:has(label:contains("Mã nhân viên")) select') ||
                         doc.querySelector('select[name*="employee"]') ||
                         doc.querySelector('select[name*="userCode"]');
        if (nvSelect) nvId = '#' + nvSelect.id;
    }
    await selectLOVById(nvId, testData.maNV);

    // --- 3. Ngày hiệu lực ---
    console.log(`\n[DATE] Đang điền Ngày hiệu lực: "${testData.ngayHieuLuc}"...`);
    const dateInput = doc.querySelector('#activeTime') || doc.querySelector('input[name*="activeTime"]');
    if (dateInput) {
        dateInput.focus();
        dateInput.value = testData.ngayHieuLuc;
        dateInput.dispatchEvent(new Event('input', { bubbles: true }));
        dateInput.dispatchEvent(new Event('change', { bubbles: true }));
        dateInput.dispatchEvent(new Event('blur', { bubbles: true }));
        console.log(`✔ Đã điền Ngày hiệu lực vào #activeTime`);
    }

    // --- 4. Đơn vị ---
    let dvId = 'select#branchUuid, select#branch';
    if (!doc.querySelector(dvId)) {
        const dvSelect = doc.querySelector('select[name*="branch"]') ||
                         doc.querySelector('select#orgUnit');
        if (dvSelect) dvId = '#' + dvSelect.id;
    }
    await selectLOVById(dvId, testData.donVi);

    console.log("\n=== HOÀN TẤT ĐIỀN FORM V5 ===");
})();
