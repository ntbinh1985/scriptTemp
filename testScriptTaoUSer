(async function testFillCreateUserFormV2() {
    console.log("=== BẮT ĐẦU TEST ĐIỀN FORM TẠO USER (V2) ===");

    // ==========================================
    // 0. DỮ LIỆU CẦN ĐIỀN
    // ==========================================
    const testData = {
        maKH: "03431837",            // Mã khách hàng
        maNV: "02760",               // Mã nhân viên
        ngayHieuLuc: "09/11/2026",   // Ngày hiệu lực dd/MM/yyyy
        donVi: "069"                 // Điền Mã đơn vị (hoặc "HOI SO")
    };

    // ==========================================
    // 1. TÌM DOCUMENT VÀ IFRAME
    // ==========================================
    let doc = document;
    let win = window;
    const iframe = document.querySelector('iframe[src*="tao-moi-nguoi-dung"]') ||
                   document.querySelector('iframe[src*="nguoi-dung"]') || 
                   document.querySelector('iframe[src*="user"]') ||
                   document.querySelector('div.window.active iframe');

    if (iframe) {
        doc = iframe.contentDocument || iframe.contentWindow.document;
        win = iframe.contentWindow;
        console.log("-> Đã phát hiện và truy cập vào IFrame:", iframe.src || iframe.id);
    } else {
        console.log("-> Thao tác trực tiếp trên document chính");
    }

    const sleep = (ms) => new Promise(resolve => setTimeout(resolve, ms));

    // ==========================================
    // 2. HÀM TÌM VÀ ĐIỀN INPUT DỰA THEO NHÃN (LABEL)
    // ==========================================
    async function setInputByLabel(labelText, value) {
        console.log(`\n[INPUT] Đang điền trường "${labelText}": "${value}"...`);

        // Tìm tất cả các container/section/label chứa text
        const allSections = Array.from(doc.querySelectorAll('section, div.row > div, div.form-group, label'));
        const container = allSections.find(el => {
            const txt = el.textContent || "";
            // Kiểm tra khớp tương đối nhưng không lấy nhãn của mục con khác
            return txt.normalize('NFC').includes(labelText.normalize('NFC')) && el.querySelector('input');
        });

        if (!container) {
            console.error(`❌ Không tìm thấy vùng chứa nhãn: "${labelText}"`);
            return false;
        }

        const input = container.querySelector('input');
        if (!input) {
            console.error(`❌ Không tìm thấy ô input của nhãn: "${labelText}"`);
            return false;
        }

        // Bỏ thuộc tính disabled/readonly tạm thời nếu có để điền
        input.focus();
        input.value = value;

        // Bắn chuỗi sự kiện để form Angular/jQuery/Liferay cập nhật model
        input.dispatchEvent(new Event('input', { bubbles: true }));
        input.dispatchEvent(new Event('change', { bubbles: true }));
        
        // Bắn phím Enter nếu hệ thống nghe phím Enter để trigger tìm kiếm
        input.dispatchEvent(new KeyboardEvent('keydown', { bubbles: true, cancelable: true, keyCode: 13, key: 'Enter' }));
        input.dispatchEvent(new KeyboardEvent('keyup', { bubbles: true, cancelable: true, keyCode: 13, key: 'Enter' }));
        
        // Mất tiêu điểm để trigger validate
        input.dispatchEvent(new Event('blur', { bubbles: true }));
        
        console.log(`✔ Đã gán giá trị "${value}" vào input:`, input);
        await sleep(500);

        // Kiểm tra xem có popup kết quả (Select2 hoặc Autocomplete menu) mở ra không
        const autocompleteMenu = doc.querySelector('ul.ui-autocomplete:not([style*="display: none"])') ||
                                 doc.querySelector('ul.select2-results__options') ||
                                 doc.querySelector('.dropdown-menu.show');

        if (autocompleteMenu) {
            const firstItem = autocompleteMenu.querySelector('li:not(.loading-results):not(.select2-results__message)');
            if (firstItem) {
                console.log(`-> Tìm thấy danh sách gợi ý, tự động click dòng đầu: "${firstItem.textContent.trim()}"`);
                firstItem.click();
                await sleep(400);
            }
        }

        return true;
    }

    // ==========================================
    // 3. THỰC THI ĐIỀN LẦN LƯỢT 4 TRƯỜNG
    // ==========================================

    // 1. Mã khách hàng
    await setInputByLabel("Mã khách hàng", testData.maKH);

    // 2. Mã nhân viên
    await setInputByLabel("Mã nhân viên", testData.maNV);

    // 3. Ngày hiệu lực (#activeTime)
    console.log(`\n[DATE] Đang điền Ngày hiệu lực: "${testData.ngayHieuLuc}"...`);
    const dateInput = doc.querySelector('#activeTime') || doc.querySelector('input[name*="activeTime"]');
    if (dateInput) {
        dateInput.focus();
        dateInput.value = testData.ngayHieuLuc;
        dateInput.dispatchEvent(new Event('input', { bubbles: true }));
        dateInput.dispatchEvent(new Event('change', { bubbles: true }));
        dateInput.dispatchEvent(new Event('blur', { bubbles: true }));
        console.log(`✔ Đã cập nhật Ngày hiệu lực thành công`);
    } else {
        console.error(`❌ Không tìm thấy ô #activeTime`);
    }
    await sleep(300);

    // 4. Đơn vị (Tìm input bên cạnh nhãn "Đơn vị")
    await setInputByLabel("Đơn vị", testData.donVi);

    console.log("\n=== HOÀN TẤT ĐIỀN FORM ===");
})();
